# Whitelist: only the port's own sources, docs, tools and patch snapshots are tracked.
# Large or external things stay out: the toolchain (toolchain-src/), the osu!/framework/native
# checkouts (src/, captured as patches/*.diff by tools/export-patches.sh), game data and logs
# (fsroot/), the user's beatmaps (import-parked/), captures and build outputs.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/FEASIBILITY.md
!/TESTING.md
!/console/
!/lx/
!/probes/
!/tools/
!/patches/
!/vk-include/

# fsroot: game data, logs, resources and the private osu! session: never tracked
!/fsroot/
/fsroot/*

# build outputs and debris inside the tracked folders
obj/
bin/
build/
*.core
*.o
*.a
*.elf
__pycache__/

# Generated from the extracted osu! resources by tools/make-icon.py (game assets are never committed)
/console/osu-game/app/icon.png

# net-probe test CA and server key (generated by tools/net-probe-server.py; never leaves the PC)
/probes/net-probe/certs/

# hub-probe: published test server
/probes/hub-probe/server/out/
*.nro
*.nacp
*.map
