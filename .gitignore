# Whitelist: only the port's own sources, docs, tools and patch snapshots are tracked.
# Large or external things stay out: the musl toolchain (toolchain/, toolchain-src/), the osu!/framework/native
# checkouts (src/, captured as patches/*.diff by tools/export-patches.sh), game data and logs (fsroot/, logs/),
# release zips (dist/), captures and build outputs.
/*
!/.gitignore
!/LICENSE
!/*.md
!/console/
!/lx/
!/probes/
!/tools/
!/patches/

# fsroot: game data, logs, resources and the private osu! session: never tracked
!/fsroot/
/fsroot/*

# build outputs and debris inside the tracked folders
obj/
bin/
build/
*.core
*.o
*.a
*.elf
__pycache__/


# net-probe test CA and server key (generated by tools/net-probe-server.py; never leaves the PC)
/probes/net-probe/certs/

# hub-probe: published test server
/probes/hub-probe/server/out/
*.nro
*.nacp
*.map
