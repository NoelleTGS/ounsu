<Project Sdk="Microsoft.NET.Sdk">
  <!-- osu! (lazer) on HBLauncher (Switch 2), cut-down.
       Console: ./build.sh (passes -p:HbxlBuild=true, which defines HBXL here and in osu.Framework).
       Desktop comparison build: dotnet publish -c Release -r linux-x64 -o obj/desktop -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Like osu.Desktop built from source: a local, non-deployed build.  Without it the assembly is 1.0.0, osu! treats
         itself as a deployed release: x-api-version 10000 (the server then answers in its oldest score format, which broke
         leaderboards), Sentry crash reports to ppy, no dev-build banner (2026-11-09). -->
    <Version>0.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Let osu! create named cultures ("en", ...) in invariant mode; they behave as invariant. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <StripSymbols>false</StripSymbols>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <!-- osu sets this in its Directory.Build.props; keep the trim warnings visible here. -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HbxlBuild)' == 'true'">
    <RuntimeIdentifier>linux-musl-arm64</RuntimeIdentifier>
    <StaticExecutable>true</StaticExecutable>
    <DefineConstants>$(DefineConstants);HBXL</DefineConstants>
    <!-- kaiHEN gives the process ~9 GiB, so code size no longer matters (hbxl needed Size for its ~240 MiB SDK heap).
         English only. -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HbxlBuild)' == 'true' Or '$(HbxlDetachTest)' == 'true'">
    <!-- osu.Game's SettingsOverlay.CreateExtraSections exists (src/osu/osu.Game/osu.Game.csproj defines the same constant):
         the "Switch 2" settings section, Switch2Settings.cs. Also in the desktop comparison build, to look at it on the PC. -->
    <DefineConstants>$(DefineConstants);HBXL_SETTINGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HbxlBuild)' == 'true'">
    <!-- osu.Game.Resources' 134 MB of assets come from loose files on the file server instead
         (HbxlFileResourceStore); generated by tools/resource-extract. -->
    <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)osu-resources.substitutions.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/osu/osu.Game/osu.Game.csproj" />
    <ProjectReference Include="../../src/osu/osu.Game.Rulesets.Osu/osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="../../src/osu/osu.Game.Rulesets.Taiko/osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="../../src/osu/osu.Game.Rulesets.Catch/osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="../../src/osu/osu.Game.Rulesets.Mania/osu.Game.Rulesets.Mania.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reflection-heavy: dependency injection, ruleset discovery, mod settings, JSON, Realm. -->
    <TrimmerRootAssembly Include="osu.Framework" />
    <TrimmerRootAssembly Include="osu.Game" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Osu" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Taiko" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Catch" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Mania" />
    <TrimmerRootAssembly Include="Realm" />
    <!-- [LocalisableDescription(typeof(FriendsStrings), nameof(FriendsStrings.TitleCompact))] etc. look up static
         properties by name (osu.Framework ExtensionMethods.GetLocalisableDescription). Its embedded assets are
         still removed by osu-resources.substitutions.xml. -->
    <TrimmerRootAssembly Include="osu.Game.Resources" />
    <!-- AutoMapper is no longer used under HBXL (RealmObjectExtensions → HbxlRealmCopier), so it isn't rooted. -->
    <TrimmerRootAssembly Include="ppy.Veldrid.SPIRV" />
    <!-- Converters named in [JsonConverter(typeof(StringEnumConverter))] are created by reflection; trimmed, their
         constructors vanished: every score save ("Score import failed!") and .osr import failed. -->
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <!-- Veldrid's structs (ResourceLayoutDescription, VertexElementDescription, ...) are serialised into the shader cache
         by Newtonsoft; trimmed, their fields had no metadata and were written as "{}", and loading those zeroed
         layouts crashed the GPU driver (2026-11-08). The framework now also rejects such entries under HBXL. -->
    <TrimmerRootAssembly Include="ppy.Veldrid" />
  </ItemGroup>
  <ItemGroup>
    <!-- 640 MiB inside the 1 GiB RegionRange below (768 froze again 2026-11-09 evening: back-to-back allocation GCs of
         ~180 ms with ~350 MiB live, while downloading 3 maps from the profile; 640/1024 passed the same PC stress test).
         Was: 768 MiB inside the 1 GiB RegionRange below (real memory on hbxl: its mmap commits eagerly). The GC needs well over
         100 MiB of range headroom above what it commits: 960 MiB / 1 GiB crashed the GC in make_heap_segment on the PC
         (reproduced 2026-11-09) and froze osu! on the console in back-to-back 200 ms full GCs. 768 / 1 GiB survives it. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="671088640" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionRange" Value="1073741824" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Audio: osu-framework's SDL3 backend (PR #6002) with mysoundlib compiled in. On for the console build; the desktop
         comparison build needs -p:HbxlAudio=true on the command line (a global property, so osu.Framework sees it too). -->
    <HbxlAudio Condition="'$(HbxlAudio)' == '' And '$(HbxlBuild)' == 'true'">true</HbxlAudio>
  </PropertyGroup>
  <ItemGroup Condition="'$(HbxlAudio)' == 'true'">
    <!-- mysoundlib-hbxl's [UnmanagedCallersOnly(EntryPoint = "msl...")] methods become global symbols, and its bindings'
         DllImport("mysoundlib") calls link straight to them. -->
    <UnmanagedEntryPointsAssembly Include="mysoundlib-hbxl" />
    <DirectPInvoke Include="mysoundlib" />
    <!-- FFmpeg.AutoGen's vectors are resolved by name (DynamicallyLoadedBindings); SoundTouch/NAudio are plain code. -->
    <TrimmerRootAssembly Include="mysoundlib-hbxl" />
  </ItemGroup>
  <ItemGroup>
    <!-- Value-type collections Newtonsoft builds by reflection (List<BeatmapSetOnlineNomination> ...) and Cursor's
         extension-data dictionary: NativeAOT has no code/metadata for them otherwise.  Generated by tools/gen-rdxml
         (build.sh re-runs it).  Broke news, beatmap search and beatmap sets on 2026-11-09. -->
    <RdXmlFile Include="rd.xml" Condition="Exists('rd.xml')" />
  </ItemGroup>
  <ItemGroup Condition="'$(HbxlBuild)' == 'true'">
    <!-- hbxl sockets are IPv4 only (sdk/linux/net.c): no AF_INET6 / dual-mode sockets. -->
    <RuntimeHostConfigurationOption Include="System.Net.DisableIPv6" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(HbxlBuild)' == 'true'">
    <!-- Bound at link time: no dlopen on the console. -->
    <DirectPInvoke Include="libc" />
    <DirectPInvoke Include="libdl.so.2" />
    <DirectPInvoke Include="libdl" />
    <DirectPInvoke Include="hbxl" />
    <DirectPInvoke Include="SDL3" />
    <DirectPInvoke Include="libveldrid-spirv" />
    <DirectPInvoke Include="bass" />
    <DirectPInvoke Include="bass_fx" />
    <DirectPInvoke Include="bassmix" />
    <DirectPInvoke Include="realm-wrappers" />
    <DirectPInvoke Include="e_sqlite3" />
  </ItemGroup>
</Project>
