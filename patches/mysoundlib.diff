+                int ret = t.Player.CalculateAmplitude(movePos.ToBool(), fftSpan, ampSpan, out var len);
+
+                if (pointLen != null)
+                    *pointLen = (nuint)len;
+
+                return ret;
+            });
+        }
+
+        // SAMPLEFACTORY
+
+        [UnmanagedCallersOnly(EntryPoint = "mslCreateSampleFactory")]
+        public static IntPtr mslCreateSampleFactory()
+        {
+            return AllocHandle(new SampleFactory());
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslRunSampleFactoryDecoder")]
+        public static void mslRunSampleFactoryDecoder(IntPtr factory, IntPtr opaque, avio_alloc_context_read_packet_func read, avio_alloc_context_seek_func seek)
+        {
+            UseResolvedHandle<SampleFactory>(factory, f => f.RunDecoder(opaque, read, seek));
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslRunSampleFactoryDecoderWithPath")]
+        public static void mslRunSampleFactoryDecoderWithPath(IntPtr factory, byte* path)
+        {
+            var str = Marshal.PtrToStringUTF8((IntPtr)path);
+
+            if (str != null)
+                UseResolvedHandle<SampleFactory>(factory, f => f.RunDecoderWithPath(str));
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslDestroySampleFactory")]
+        public static void mslDestroySampleFactory(IntPtr factory)
+        {
+            FreeHandle<SampleFactory>(factory);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleFactoryGetLength")]
+        public static double mslSampleFactoryGetLength(IntPtr factory)
+        {
+            return UseResolvedHandle<SampleFactory, double>(factory, 0.0, f => f.Length);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleFactoryIsLoaded")]
+        public static SDLBool mslSampleFactoryIsLoaded(IntPtr factory)
+        {
+            return UseResolvedHandle<SampleFactory, SDLBool>(factory, false, f => f.GetAudioData().Length > 0);
+        }
+
+        // SAMPLE
+
+        [UnmanagedCallersOnly(EntryPoint = "mslCreateSample")]
+        public static IntPtr mslCreateSample(IntPtr factory)
+        {
+            var ret = UseResolvedHandle<SampleFactory, IntPtr>(factory, IntPtr.Zero, f => AllocHandle(new Sample(f)));
+            if (ret == IntPtr.Zero)
+                return AllocHandle(new Sample(null));
+
+            return ret;
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslDestroySample")]
+        public static void mslDestroySample(IntPtr sample)
+        {
+            FreeHandle<Sample>(sample);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSamplePlay")]
+        public static void mslSamplePlay(IntPtr sample)
+        {
+            UseResolvedHandle<Sample>(sample, s => s.Playing = true);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSamplePause")]
+        public static void mslSamplePause(IntPtr sample)
+        {
+            UseResolvedHandle<Sample>(sample, s => s.Playing = false);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleIsPlaying")]
+        public static SDLBool mslSampleIsPlaying(IntPtr sample)
+        {
+            return UseResolvedHandle<Sample, SDLBool>(sample, false, s => s.Playing);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleSetVolume")]
+        public static void mslSampleSetVolume(IntPtr sample, double volume, double balance)
+        {
+            UseResolvedHandle<Sample>(sample, s => (s as IAudioChannel).SetVolume((float)volume, (float)balance));
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleGetFrequency")]
+        public static double mslSampleGetFrequency(IntPtr sample)
+        {
+            return UseResolvedHandle<Sample, double>(sample, 1.0, s => s.Rate);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleSetFrequency")]
+        public static void mslSampleSetFrequency(IntPtr sample, double rfreq)
+        {
+            UseResolvedHandle<Sample>(sample, s => s.Rate = rfreq);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleGetLoop")]
+        public static SDLBool mslSampleGetLoop(IntPtr sample)
+        {
+            return UseResolvedHandle<Sample, SDLBool>(sample, false, s => s.Looping);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleSetLoop")]
+        public static void mslSampleSetLoop(IntPtr sample, byte loop)
+        {
+            UseResolvedHandle<Sample>(sample, s => s.Looping = loop.ToBool());
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSampleIsDone")]
+        public static SDLBool mslSampleIsDone(IntPtr sample)
+        {
+            return UseResolvedHandle<Sample, SDLBool>(sample, true, s => s.Player.Done);
+        }
+
+        // DECODER
+
+        [UnmanagedCallersOnly(EntryPoint = "mslCreateAudioDecoder")]
+        public static IntPtr mslCreateAudioDecoder(IntPtr opaque, avio_alloc_context_read_packet_func read, avio_alloc_context_seek_func seek,
+            SDL_AudioSpec spec, byte isTrack, IntPtr userdata, DataCallbackFunc callback)
+        {
+            Decoder.DataCallback cb = (data, done) =>
+            {
+                fixed (byte* ptr = data)
+                    callback.FuncPtr(userdata, (IntPtr)ptr, data.Length, done.ToIntBool());
+            };
+
+            var decoder = Decoder.CreateDecoder(opaque, read, seek, cb, spec, isTrack.ToBool());
+            return AllocHandle(decoder);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslCreateAudioDecoderWithPath")]
+        public static IntPtr mslCreateAudioDecoderWithPath(byte* path,
+            SDL_AudioSpec spec, byte isTrack, IntPtr userdata, DataCallbackFunc callback)
+        {
+            var str = Marshal.PtrToStringUTF8((IntPtr)path);
+            if (str == null)
+                return IntPtr.Zero;
+
+            Decoder.DataCallback cb = (data, done) =>
+            {
+                fixed (byte* ptr = data)
+                    callback.FuncPtr(userdata, (IntPtr)ptr, data.Length, done.ToIntBool());
+            };
+
+            var decoder = Decoder.CreateDecoderWithPath(str, cb, spec, isTrack.ToBool());
+            return AllocHandle(decoder);
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslDestroyAudioDecoder")]
+        public static void mslDestroyAudioDecoder(IntPtr* decoderptr)
+        {
+            if (decoderptr == null)
+                return;
+
+            IntPtr decoder = *decoderptr;
+
+            if (decoder == IntPtr.Zero)
+                return;
+
+            using var handle = new ObjectHandle<Decoder>(decoder, true);
+            if (handle.GetTarget(out var d))
+                d.Dispose();
+
+            *decoderptr = IntPtr.Zero;
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslDecoderGetMetadata")]
+        public static void mslDecoderGetMetadata(IntPtr decoder, int* bitrate, double* length, nuint* bytelen)
+        {
+            UseResolvedHandle<Decoder>(decoder, d =>
+            {
+                d.GetMetadata(out var br, out var len, out var blen);
+
+                if (bitrate != null)
+                    *bitrate = br;
+
+                if (length != null)
+                    *length = len;
+
+                if (bytelen != null)
+                    *bytelen = (nuint)blen;
+            });
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslDecoderProcessChunk")]
+        public static int mslDecoderProcessChunk(IntPtr decoder)
+        {
+            return UseResolvedHandle<Decoder, int>(decoder, 0, d => d.ProcessChunk());
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslDecoderIsDone")]
+        public static SDLBool mslDecoderIsDone(IntPtr decoder)
+        {
+            return UseResolvedHandle<Decoder, SDLBool>(decoder, true, d => d.Done);
+        }
+    }
+}
