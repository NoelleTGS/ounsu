+        private static IntPtr AllocHandle<T>(T obj) where T : class
+        {
+            return new ObjectHandle<T>(obj, GCHandleType.Normal).Handle;
+        }
+
+        internal static T? ResolveHandle<T>(IntPtr ptr) where T : class
+        {
+            if (ptr == IntPtr.Zero)
+                return null;
+
+            var handle = new ObjectHandle<T>(ptr);
+            return handle.GetTarget(out T target) ? target : null;
+        }
+
+        internal static bool UseResolvedHandle<T>(IntPtr ptr, Action<T> action) where T : class
+        {
+            var handle = ResolveHandle<T>(ptr);
+            if (handle != null)
+            {
+                action(handle);
+                return true;
+            }
+            else
+            {
+                return false;
+            }
+        }
+
+        internal static R UseResolvedHandle<T, R>(IntPtr ptr, R def, Func<T, R> action) where T : class
+        {
+            var handle = ResolveHandle<T>(ptr);
+            if (handle != null)
+            {
+                return action(handle);
+            }
+            else
+            {
+                return def;
+            }
+        }
+
+        internal static void FreeHandle<T>(IntPtr ptr, bool dispose = false) where T : class
+        {
+            if (ptr != IntPtr.Zero)
+            {
+                var handle = new ObjectHandle<T>(ptr, true);
+                if (dispose && handle.GetTarget(out var target) && target is IDisposable disposable)
+                    disposable.Dispose();
+
+                handle.Dispose();
+            }
+        }
