+#if !HBXL_NO_BASS // HBXL: one binary; SDL3 is the host's (osu-framework's) and already bound
+            NativeLibrary.SetDllImportResolver(typeof(SDL3).Assembly, (name, _, _) => LoadNativeLibrary(name));
+            NativeLibrary.SetDllImportResolver(typeof(Bass).Assembly, (name, _, _) => LoadNativeLibrary(name));
+            NativeLibrary.SetDllImportResolver(typeof(BassMix).Assembly, (name, _, _) => LoadNativeLibrary(name));
+#endif
+        }
