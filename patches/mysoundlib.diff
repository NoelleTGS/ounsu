+            {
+                var list = m.GetAudioDeviceList();
+                byte** ptrList = (byte**)NativeMemory.AllocZeroed((nuint)list.Length + 1, (nuint)sizeof(byte*));
+
+                for (int i = 0; i < list.Length; i++)
+                {
+                    byte[] conv = Encoding.UTF8.GetBytes(list[i]);
+                    byte* ptr = (byte*)NativeMemory.AllocZeroed((nuint)conv.Length + 1, (nuint)sizeof(byte));
