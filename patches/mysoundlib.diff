diff --git a/hbxl/mysoundlib-hbxl.csproj b/hbxl/mysoundlib-hbxl.csproj
new file mode 100644
index 0000000..4b9a449
--- /dev/null
+++ b/hbxl/mysoundlib-hbxl.csproj
@@ -0,0 +1,31 @@
+<Project Sdk="Microsoft.NET.Sdk">
+  <!-- HBLauncher (Switch 2) build of mysoundlib: bindings (mysoundlib_cs) and library (native_audio_library) in one
+       managed assembly, compiled into the app by NativeAOT instead of being loaded as libmysoundlib.so.
+       The bindings' DllImport("mysoundlib") calls resolve to the library's [UnmanagedCallersOnly(EntryPoint = "msl...")]
+       exports through DirectPInvoke + UnmanagedEntryPointsAssembly in the app project.
+       BASS decoding and ASIO output are left out (HBXL_NO_BASS): FFmpeg decodes, SDL3 plays.
+       HBXL_IN_PROCESS drops the bindings' [SuppressGCTransition]: the callee is managed code in the same runtime, and
+       entering it without the transition is a fail-fast ("attempted to call a UnmanagedCallersOnly method"). -->
+  <PropertyGroup>
+    <TargetFramework>net10.0</TargetFramework>
+    <AssemblyName>mysoundlib-hbxl</AssemblyName>
+    <RootNamespace>native_audio_library</RootNamespace>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <Nullable>enable</Nullable>
+    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
+    <IsAotCompatible>true</IsAotCompatible>
+    <DefineConstants>$(DefineConstants);HBXL_NO_BASS;HBXL_IN_PROCESS</DefineConstants>
+    <NoWarn>$(NoWarn);CS1591</NoWarn>
+  </PropertyGroup>
+  <ItemGroup>
+    <Compile Include="../bindings/*.cs" />
+    <Compile Include="../library/*.cs" Exclude="../library/BassDecoder.cs;../library/NAudioAsioManager.cs" />
+  </ItemGroup>
+  <ItemGroup>
+    <PackageReference Include="NAudio.Core" Version="2.2.1" />
+    <!-- Same version as osu.Framework's. -->
+    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
+    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
+    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
+  </ItemGroup>
+</Project>
diff --git a/library/SegmentedPcm.cs b/library/SegmentedPcm.cs
new file mode 100644
index 0000000..6d812d9
--- /dev/null
+++ b/library/SegmentedPcm.cs
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: LGPL-2.1-only */
+
+#if HBXL_IN_PROCESS
+namespace native_audio_library
+{
+    /// <summary>
+    /// HBLauncher (Switch 2): a decoded track as 16-bit PCM in 64 KiB segments.
+    /// The console's managed heap is small (768 MiB hard limit, 1 GiB region range), and whole songs live in it. One array per
+    /// song (40-85 MB) lands on the large object heap, which needs contiguous space: after a few map changes the range was so
+    /// fragmented that even a 4 MiB array couldn't be placed (OutOfMemoryException with ~270 MiB in use). Segments stay below
+    /// the LOH threshold, are compacted like any other object, and growing never copies.
+    /// </summary>
+    internal sealed class SegmentedPcm
+    {
+        private const int segment_bits = 15;
+        private const int segment_length = 1 << segment_bits; // 32768 samples = 64 KiB
+        private const int segment_mask = segment_length - 1;
+        private const float s16_to_float = 1f / 32768f;
+
+        private readonly List<short[]> segments = new List<short[]>();
+
+        /// <summary>Capacity in samples.</summary>
+        public long LongLength => (long)segments.Count << segment_bits;
+
+        public void EnsureCapacity(long samples)
+        {
+            while (LongLength < samples)
+                segments.Add(new short[segment_length]);
+        }
+
+        public short this[long index]
+        {
+            get => segments[(int)(index >> segment_bits)][index & segment_mask];
+            set => segments[(int)(index >> segment_bits)][index & segment_mask] = value;
+        }
+
+        /// <summary>Converts float samples to 16-bit and stores them at <paramref name="index"/> (capacity must be ensured).</summary>
+        public void Write(long index, ReadOnlySpan<float> src)
+        {
+            while (src.Length > 0)
+            {
+                short[] seg = segments[(int)(index >> segment_bits)];
+                int at = (int)(index & segment_mask);
+                int n = Math.Min(src.Length, segment_length - at);
+
+                for (int i = 0; i < n; i++)
+                    seg[at + i] = (short)Math.Clamp(MathF.Round(src[i] * 32768f), -32768f, 32767f);
+
+                src = src.Slice(n);
+                index += n;
+            }
+        }
+
+        /// <summary>Copies <paramref name="count"/> samples starting at <paramref name="index"/> into <paramref name="dst"/> as floats.</summary>
+        public void CopyOut(long index, float[] dst, int dstIndex, int count)
+        {
+            while (count > 0)
+            {
+                short[] seg = segments[(int)(index >> segment_bits)];
+                int at = (int)(index & segment_mask);
+                int n = Math.Min(count, segment_length - at);
+
+                for (int i = 0; i < n; i++)
+                    dst[dstIndex + i] = seg[at + i] * s16_to_float;
+
+                index += n;
+                dstIndex += n;
+                count -= n;
+            }
+        }
+    }
+}
+#endif
