+
+        [StructLayout(LayoutKind.Sequential)]
+        public struct LoadLibraryFunc
+        {
+            public delegate* unmanaged[Cdecl]<byte*, nint> FuncPtr;
+        }
+
+        [StructLayout(LayoutKind.Sequential)]
+        public struct LoadSymbolFunc
+        {
+            public delegate* unmanaged[Cdecl]<nint, byte*, nint> FuncPtr;
+        }
+
+        [StructLayout(LayoutKind.Sequential)]
+        public struct CloseLibraryFunc
+        {
+            public delegate* unmanaged[Cdecl]<nint, void> FuncPtr;
+        }
+
+        private static LogFunc? nativeLogger;
+
+        public static void Log(string msg)
+        {
+            if (nativeLogger is LogFunc log)
+            {
+                byte[] conv = Encoding.UTF8.GetBytes(msg + '\0');
+                fixed (byte* ptr = conv)
+                    log.FuncPtr(ptr);
+            }
+            else
+            {
+                Console.Error.WriteLine(msg);
+            }
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "mslSetLogFunction")]
+        public static void mslSetLogFunction(LogFunc log)
+        {
+            nativeLogger = log;
+        }
+
+        private static LoadLibraryFunc? loadLib;
+        private static LoadSymbolFunc? loadSym;
+        private static CloseLibraryFunc? closeLib;
+
+        public static nint LoadNativeLibrary(string name)
+        {
+            nint handle;
+
+            if (loadLib is LoadLibraryFunc load)
+            {
+                byte[] conv = Encoding.UTF8.GetBytes(name + '\0');
+                fixed (byte* ptr = conv)
+                    handle = load.FuncPtr(ptr);
+            }
+            else
+            {
+                handle = NativeLibrary.Load(name);
+            }
+
+            if (handle == IntPtr.Zero)
+                Log("Couldn't load a library: " + name);
+
+            return handle;
+        }
+
+        public static void* GetSymbol(nint handle, string name)
+        {
+            nint symbol;
+
+            if (loadSym is LoadSymbolFunc sym)
+            {
+                byte[] conv = Encoding.UTF8.GetBytes(name + '\0');
+                fixed (byte* ptr = conv)
+                    symbol = sym.FuncPtr(handle, ptr);
+            }
+            else
+            {
+                symbol = NativeLibrary.GetExport(handle, name);
+            }
+
+            if (symbol == IntPtr.Zero)
+                Log("Couldn't load a symbol: " + name);
+
+            return (void*)symbol;
+        }
+
+        public static void CloseNativeLibrary(nint handle)
+        {
+            if (closeLib is CloseLibraryFunc close)
+                close.FuncPtr(handle);
+            else
+                NativeLibrary.Free(handle);
+        }
