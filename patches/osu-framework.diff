@@ -0,0 +1,35 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OUNSU
+using System;
+using System.Runtime.InteropServices;
+
+namespace osu.Framework.Platform
+{
+    /// <summary>
+    /// The console's window, from ounsu!'s native glue (console/osu-game/shim/lx_osu.c), bound at link time
+    /// (DirectPInvoke "ounsu").
+    /// </summary>
+    internal static partial class OunsuNative
+    {
+        [LibraryImport("ounsu", EntryPoint = "ounsu_vi_window")]
+        internal static partial IntPtr ViWindow();
+
+        [LibraryImport("ounsu", EntryPoint = "ounsu_display")]
+        private static unsafe partial void ounsu_display(uint* out5);
+
+        /// <summary>
+        /// The console's window now: its size in this console mode (docked or handheld), the frame rate it presents at,
+        /// and a serial that changes with any of them. Also lets the runtime handle the console's applet messages
+        /// (docking), so the window thread calls it once per frame.
+        /// </summary>
+        internal static unsafe (int Width, int Height, int FrameRate, uint Serial) Display()
+        {
+            uint* d = stackalloc uint[5];
+            ounsu_display(d);
+            return ((int)d[0], (int)d[1], (int)d[3], d[4]);
+        }
+    }
+}
+#endif
