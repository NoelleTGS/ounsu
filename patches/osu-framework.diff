@@ -0,0 +1,24 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using System;
+
+namespace osu.Framework.Bindables
+{
+    /// <summary>
+    /// Lets code that only knows a bindable as <see cref="object"/> read it and react to value changes
+    /// without reflection over generic types or methods (not AOT-safe for value types; used by the
+    /// Switch 2 port, e.g. osu!'s mod setting dropdowns for enum settings).
+    /// Write through <see cref="IParseable.Parse"/>.
+    /// </summary>
+    public interface INotifyValueChangedUntyped
+    {
+        void SubscribeValueChanged(Action onChange);
+
+        /// <summary>The current value, boxed.</summary>
+        object ValueUntyped { get; }
+
+        /// <summary>The default value, boxed.</summary>
+        object DefaultUntyped { get; }
+    }
+}
