+        private abstract class Erased
+        {
+            public abstract void Serialize(ref MessagePackWriter writer, object value, MessagePackSerializerOptions options);
+            public abstract object? Deserialize(ref MessagePackReader reader, MessagePackSerializerOptions options);
+        }
+
+        private sealed class Erased<T> : Erased
+        {
+            public override void Serialize(ref MessagePackWriter writer, object value, MessagePackSerializerOptions options)
+                => options.Resolver.GetFormatterWithVerify<T>().Serialize(ref writer, (T)value, options);
+
+            public override object? Deserialize(ref MessagePackReader reader, MessagePackSerializerOptions options)
+                => options.Resolver.GetFormatterWithVerify<T>().Deserialize(ref reader, options);
+        }
+
+        private static readonly Dictionary<Type, Erased> types = new Dictionary<Type, Erased>
+        {
+            // primitives
+            { typeof(bool), new Erased<bool>() },
+            { typeof(int), new Erased<int>() },
+            { typeof(long), new Erased<long>() },
+            { typeof(ulong), new Erased<ulong>() },
+            { typeof(double), new Erased<double>() },
+            { typeof(string), new Erased<string>() },
+            { typeof(int[]), new Erased<int[]>() },
+            { typeof(long[]), new Erased<long[]>() },
+
+            // metadata hub (IMetadataServer / IMetadataClient)
+            { typeof(UserStatus), new Erased<UserStatus>() },
+            { typeof(UserActivity), new Erased<UserActivity>() },
+            { typeof(UserPresence), new Erased<UserPresence>() },
+            { typeof(BeatmapUpdates), new Erased<BeatmapUpdates>() },
+            { typeof(DailyChallengeInfo), new Erased<DailyChallengeInfo>() },
+            { typeof(MultiplayerRoomScoreSetEvent), new Erased<MultiplayerRoomScoreSetEvent>() },
+            { typeof(MultiplayerPlaylistItemStats), new Erased<MultiplayerPlaylistItemStats>() },
+            { typeof(MultiplayerPlaylistItemStats[]), new Erased<MultiplayerPlaylistItemStats[]>() },
+        };
+
+        /// <summary>
+        /// Like <see cref="SignalRUnionWorkaroundResolver.OPTIONS"/>, with formatters for the constructed generic types
+        /// MessagePack would otherwise build at runtime.
+        /// </summary>
+        public static readonly MessagePackSerializerOptions OPTIONS = SignalRUnionWorkaroundResolver.OPTIONS.WithResolver(new Resolver());
+
+        public static void Serialize(ref MessagePackWriter writer, object value, MessagePackSerializerOptions options)
+        {
+            // Derived types are written as their listed base (UserActivity.InSoloGame as UserActivity: the union), which is
+            // also what SignalRUnionWorkaroundResolver does for them.
+            for (Type? type = value.GetType(); type != null && type != typeof(object); type = type.BaseType)
+            {
+                if (types.TryGetValue(type, out var erased))
+                {
+                    erased.Serialize(ref writer, value, options);
+                    return;
+                }
+            }
+
+            throw new NotSupportedException($"{value.GetType()} is not in the list of hub types (OunsuHubTypes).");
+        }
+
+        public static object? Deserialize(ref MessagePackReader reader, Type type, MessagePackSerializerOptions options)
+        {
+            Type? underlying = Nullable.GetUnderlyingType(type);
+
+            if (underlying != null)
+            {
+                if (reader.TryReadNil())
+                    return null;
+
+                type = underlying;
+            }
+
+            if (types.TryGetValue(type, out var erased))
+                return erased.Deserialize(ref reader, options);
+
+            if (type == typeof(object))
+            {
+                // a hub method declared with an object parameter: nothing here does that, skip the value
+                reader.Skip();
+                return null;
+            }
+
+            throw new NotSupportedException($"{type} is not in the list of hub types (OunsuHubTypes).");
+        }
+
+        private sealed class Resolver : IFormatterResolver
+        {
+            private static readonly Dictionary<Type, object> formatters = new Dictionary<Type, object>
+            {
+                { typeof(UserStatus), new UserStatusFormatter() },
+                { typeof(UserStatus?), new NullableFormatter<UserStatus>() },
+                { typeof(UserPresence?), new NullableFormatter<UserPresence>() },
+                { typeof(DailyChallengeInfo?), new NullableFormatter<DailyChallengeInfo>() },
+                { typeof(MultiplayerPlaylistItemStats[]), new ArrayFormatter<MultiplayerPlaylistItemStats>() },
+            };
+
+            public IMessagePackFormatter<T>? GetFormatter<T>()
+            {
+                if (formatters.TryGetValue(typeof(T), out object? formatter))
+                    return (IMessagePackFormatter<T>)formatter;
+
+                return SignalRUnionWorkaroundResolver.OPTIONS.Resolver.GetFormatter<T>();
+            }
+        }
+
+        /// <summary>
+        /// An enum as its integer value, which is what MessagePack's standard resolver writes (the server's side).
+        /// </summary>
+        internal sealed class UserStatusFormatter : IMessagePackFormatter<UserStatus>
+        {
+            public void Serialize(ref MessagePackWriter writer, UserStatus value, MessagePackSerializerOptions options) => writer.Write((int)value);
+
+            public UserStatus Deserialize(ref MessagePackReader reader, MessagePackSerializerOptions options) => (UserStatus)reader.ReadInt32();
+        }
+    }
