+<Project>
+  <!-- ounsu! (Switch 2 port): version stamp for osu.Game and the rulesets, like ppy's release builds get from CI.
+       Skin layouts name their component types with assembly versions ("osu.Game, Version=2026.807.0.0"), and a reference
+       to a higher version than the loaded assembly doesn't resolve, so with the default 0.0.0 every saved layout fell back
+       to the defaults. Stamped with the build date in osu!'s yyyy.Mdd scheme, so it is never older than a release made
+       before the build. Imported after each project file, so it overrides osu.Game.csproj's 0.0.0. The console entry
+       assembly (console/osu-game, outside this tree) stays 0.0.0 on purpose: osu! treats that one as "not deployed". -->
+  <PropertyGroup Condition="'$(OunsuBuild)' == 'true' Or '$(OunsuDetachTest)' == 'true'">
+    <Version>$([System.DateTime]::Now.ToString('yyyy.Mdd')).0</Version>
+  </PropertyGroup>
+</Project>
diff --git a/osu.Game/Database/OunsuRealmCopier.cs b/osu.Game/Database/OunsuRealmCopier.cs
new file mode 100644
index 0000000000..9fd28a48e3
--- /dev/null
+++ b/osu.Game/Database/OunsuRealmCopier.cs
@@ -0,0 +1,282 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OUNSU_DETACH
+using System;
+using System.Collections;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.Serialization;
+using osu.Framework.Logging;
+using osu.Game.Beatmaps;
+using osu.Game.Rulesets;
+using Realms;
+
+namespace osu.Game.Database
+{
+    /// <summary>
+    /// Switch 2 port: AutoMapper-free replacement for the mappers in <see cref="RealmObjectExtensions"/>.
+    /// </summary>
+    /// <remarks>
+    /// AutoMapper doesn't work under NativeAOT: sealing a <c>MapperConfiguration</c> reflects over generic
+    /// interface instantiations (e.g. <c>IList&lt;string&gt;.GetEnumerator</c>), which have no metadata, and it compiles
+    /// expression trees. This copier follows the same rules as the AutoMapper configurations it replaces, but only
+    /// uses plain <see cref="PropertyInfo"/> get/set on non-generic types (osu.Game is a rooted assembly in the
+    /// console build, so all of that metadata exists):
+    /// <list type="bullet">
+    /// <item>members marked <see cref="IgnoredAttribute"/>, <see cref="BacklinkAttribute"/> or <see cref="IgnoreDataMemberAttribute"/> are skipped;</item>
+    /// <item>detach maps properties with a public getter: settable ones are assigned (realm objects are detached recursively),
+    /// get-only <see cref="IList{T}"/> properties (realm lists) are refilled;</item>
+    /// <item>copy-to-realm maps properties with a public setter, plus the explicit after-map steps of the original.</item>
+    /// </list>
+    /// Like the original <c>MaxDepth</c> maps (which preserve references), <see cref="BeatmapInfo"/> and
+    /// <see cref="BeatmapSetInfo"/> are detached once per graph, so cycles between them resolve to the same instance.
+    /// </remarks>
+    internal static class OunsuRealmCopier
+    {
+        private static readonly ConcurrentDictionary<Type, PropertyInfo[]> detach_properties = new ConcurrentDictionary<Type, PropertyInfo[]>();
+        private static readonly ConcurrentDictionary<Type, PropertyInfo[]> write_properties = new ConcurrentDictionary<Type, PropertyInfo[]>();
+
+        #region Detach
+
+        /// <param name="item">A managed realm object.</param>
+        /// <param name="beatmapSetMapper">Behave like the optimised <c>beatmap_set_mapper</c>
+        /// (<see cref="BeatmapSetInfo.Files"/> and <see cref="BeatmapInfo.BeatmapSet"/> aren't mapped).</param>
+        public static T Detach<T>(T item, bool beatmapSetMapper) where T : RealmObjectBase
+            => (T)new DetachContext(beatmapSetMapper).Detach(item);
+
+        private class DetachContext
+        {
+            private readonly bool beatmapSetMapper;
+            private readonly Dictionary<(Type, Guid), RealmObjectBase> references = new Dictionary<(Type, Guid), RealmObjectBase>();
+
+            public DetachContext(bool beatmapSetMapper)
+            {
+                this.beatmapSetMapper = beatmapSetMapper;
+            }
+
+            public RealmObjectBase Detach(RealmObjectBase source)
+            {
+                var type = source.GetType();
+
+                (Type, Guid)? key = source is BeatmapInfo or BeatmapSetInfo ? (type, ((IHasGuidPrimaryKey)source).ID) : null;
+
+                if (key != null && references.TryGetValue(key.Value, out var existing))
+                    return existing;
+
+                var destination = createInstance(type);
+
+                if (key != null)
+                    references[key.Value] = destination;
+
+                foreach (var property in detach_properties.GetOrAdd(type, t => getProperties(t, write: false)))
+                {
+                    if (beatmapSetMapper && isSkippedBySetMapper(property))
+                        continue;
+
+                    object? value = property.GetValue(source);
+
+                    if (property.SetMethod != null)
+                    {
+                        property.SetValue(destination, mapValue(value));
+                    }
+                    else if (isGenericList(property.PropertyType))
+                    {
+                        // Get-only realm list: fill the destination's own (unmanaged) list.
+                        var destinationList = (IList?)property.GetValue(destination)
+                                              ?? throw new InvalidOperationException($"{type.Name}.{property.Name} has no list to fill on a new instance.");
+
+                        destinationList.Clear();
+
+                        if (value is IEnumerable sourceItems)
+                        {
+                            foreach (object? item in sourceItems)
+                                destinationList.Add(mapValue(item));
+                        }
+                    }
+
+                    // Other get-only properties are computed and can't be mapped (AutoMapper skips them too).
+                }
+
+                switch (destination)
+                {
+                    case BeatmapSetInfo set:
+                        foreach (var beatmap in set.Beatmaps)
+                            beatmap.BeatmapSet = set;
+                        break;
+
+                    case BeatmapInfo beatmap when !beatmapSetMapper:
+                        for (int i = 0; i < beatmap.BeatmapSet?.Beatmaps.Count; i++)
+                        {
+                            if (beatmap.BeatmapSet.Beatmaps[i].Equals(beatmap))
+                            {
+                                beatmap.BeatmapSet.Beatmaps[i] = beatmap;
+                                break;
+                            }
+                        }
+
+                        break;
+                }
+
+                return destination;
+            }
+
+            private object? mapValue(object? value) => value is RealmObjectBase realmObject ? Detach(realmObject) : value;
+
+            private static bool isSkippedBySetMapper(PropertyInfo property) =>
+                (property.DeclaringType == typeof(BeatmapSetInfo) && property.Name == nameof(BeatmapSetInfo.Files))
+                || (property.DeclaringType == typeof(BeatmapInfo) && property.Name == nameof(BeatmapInfo.BeatmapSet));
+
+            private static RealmObjectBase createInstance(Type type)
+            {
+                // Matches `ConstructUsing(_ => new BeatmapSetInfo(null))` in the original configuration.
+                if (type == typeof(BeatmapSetInfo))
+                    return new BeatmapSetInfo(null);
+
+                // Every realm model has a parameterless constructor (often private, used by Realm itself).
+                return (RealmObjectBase)Activator.CreateInstance(type, nonPublic: true)!;
+            }
+        }
+
+        #endregion
+
+        #region Copy changes to realm
+
+        /// <summary>
+        /// Copies a detached object's changes onto a live (managed) object, like the original <c>write_mapper</c>.
+        /// </summary>
+        public static void CopyChangesToRealm(RealmObjectBase source, RealmObjectBase destination)
+        {
+            var type = source.GetType();
+
+            foreach (var property in write_properties.GetOrAdd(type, t => getProperties(t, write: true)))
+            {
+                if (isIgnoredByWriteMapper(property))
+                    continue;
+
+                object? value = property.GetValue(source);
+
+                if (value is RealmObjectBase nestedSource)
+                {
+                    // No current model reaches here (all such members are handled explicitly below), but don't attach
+                    // a detached object to a live one by accident.
+                    if (property.GetValue(destination) is RealmObjectBase nestedDestination)
+                        CopyChangesToRealm(nestedSource, nestedDestination);
+                    else
+                        throw new InvalidOperationException($"{type.Name}.{property.Name}: no live object to copy changes into.");
+
+                    continue;
+                }
+
+                property.SetValue(destination, value);
+            }
+
+            switch (source)
+            {
+                case BeatmapMetadata s:
+                    CopyChangesToRealm(s.Author, ((BeatmapMetadata)destination).Author);
+                    break;
+
+                case BeatmapInfo s:
+                {
+                    var d = (BeatmapInfo)destination;
+                    d.Ruleset = d.Realm!.Find<RulesetInfo>(s.Ruleset.ShortName)!;
+                    CopyChangesToRealm(s.Difficulty, d.Difficulty);
+                    CopyChangesToRealm(s.Metadata, d.Metadata);
+                    break;
+                }
+
+                case BeatmapSetInfo s:
+                {
+                    var d = (BeatmapSetInfo)destination;
+
+                    foreach (var beatmap in s.Beatmaps)
+                    {
+                        // Importantly, search all of realm for the beatmap (not just the set's beatmaps).
+                        // It may have gotten detached, and if that's the case let's use this opportunity to fix
+                        // things up.
+                        var existingBeatmap = d.Realm!.Find<BeatmapInfo>(beatmap.ID);
+
+                        if (existingBeatmap != null)
+                        {
+                            // As above, reattach if it happens to not be in the set's beatmaps.
+                            if (!d.Beatmaps.Contains(existingBeatmap))
+                            {
+                                Debug.Fail("Beatmaps should never become detached under normal circumstances. If this ever triggers, it should be investigated further.");
+                                Logger.Log("WARNING: One of the difficulties in a beatmap was detached from its set. Please save a copy of logs and report this to devs.", LoggingTarget.Database,
+                                    LogLevel.Important);
+                                d.Beatmaps.Add(existingBeatmap);
+                            }
+
+                            CopyChangesToRealm(beatmap, existingBeatmap);
+                        }
+                        else
+                        {
+                            var newBeatmap = new BeatmapInfo
+                            {
+                                ID = beatmap.ID,
+                                BeatmapSet = d,
+                                Ruleset = d.Realm.Find<RulesetInfo>(beatmap.Ruleset.ShortName)!
+                            };
+
+                            d.Beatmaps.Add(newBeatmap);
+                            CopyChangesToRealm(beatmap, newBeatmap);
+                        }
+                    }
+
+                    break;
+                }
+            }
+        }
+
+        private static bool isIgnoredByWriteMapper(PropertyInfo property)
+        {
+            if (property.DeclaringType == typeof(BeatmapMetadata))
+                return property.Name == nameof(BeatmapMetadata.Author);
+
+            if (property.DeclaringType == typeof(BeatmapInfo))
+            {
+                switch (property.Name)
+                {
+                    case nameof(BeatmapInfo.Ruleset):
+                    case nameof(BeatmapInfo.Metadata):
+                    case nameof(BeatmapInfo.UserSettings):
+                    case nameof(BeatmapInfo.Difficulty):
+                    case nameof(BeatmapInfo.BeatmapSet):
+                        return true;
+                }
+            }
+
+            if (property.DeclaringType == typeof(BeatmapSetInfo))
+                return property.Name == nameof(BeatmapSetInfo.Beatmaps);
+
+            return false;
+        }
+
+        #endregion
+
+        /// <param name="type">The model type.</param>
+        /// <param name="write"><c>false</c>: <c>ShouldMapProperty = GetMethod is public</c> (detach);
+        /// <c>true</c>: <c>ShouldMapProperty = SetMethod is public</c> (copy to realm).</param>
+        private static PropertyInfo[] getProperties(Type type, bool write)
+        {
+            var realmAssembly = typeof(RealmObjectBase).Assembly;
+
+            return type.GetProperties(BindingFlags.Public | BindingFlags.Instance)
+                       .Where(p => p.GetIndexParameters().Length == 0)
+                       // RealmObjectBase's own members (IsManaged, Realm, ObjectSchema, DynamicApi, ...) aren't model data.
+                       .Where(p => p.DeclaringType?.Assembly != realmAssembly)
+                       .Where(p => p.GetMethod != null && (write ? p.SetMethod?.IsPublic == true : p.GetMethod.IsPublic))
+                       .Where(p => !Attribute.IsDefined(p, typeof(IgnoredAttribute))
+                                   && !Attribute.IsDefined(p, typeof(BacklinkAttribute))
+                                   && !Attribute.IsDefined(p, typeof(IgnoreDataMemberAttribute)))
+                       .ToArray();
+        }
+
+        private static bool isGenericList(Type type) => type.IsGenericType && type.GetGenericTypeDefinition() == typeof(IList<>);
+    }
+}
+#endif
diff --git a/osu.Game/IO/OunsuFileResourceStore.cs b/osu.Game/IO/OunsuFileResourceStore.cs
new file mode 100644
index 0000000000..2e995ed51e
--- /dev/null
+++ b/osu.Game/IO/OunsuFileResourceStore.cs
@@ -0,0 +1,98 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OUNSU
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Threading;
+using System.Threading.Tasks;
+using osu.Framework.IO.Stores;
+
+namespace osu.Game.IO
+{
+    /// <summary>
+    /// Switch 2 port: an assembly's embedded resources served from loose files.
+    /// The console binary is limited by the SDK heap, so the NativeAOT build drops
+    /// osu.Game.Resources' embedded assets (ILLink substitutions) and they are extracted on the PC
+    /// as files named by their manifest resource names (tools/resource-extract). Lookups follow
+    /// <see cref="DllResourceStore"/>'s naming exactly; anything not on disk (e.g. compiled
+    /// .resources tables) falls back to the assembly.
+    /// </summary>
+    public class OunsuFileResourceStore : IResourceStore<byte[]>
+    {
+        private readonly string directory;
+        private readonly string prefix;
+        private readonly DllResourceStore fallback;
+
+        public OunsuFileResourceStore(string directory, Assembly assembly)
+        {
+            this.directory = directory;
+            prefix = assembly.GetName().Name!;
+            fallback = new DllResourceStore(assembly);
+        }
+
+        private string manifestName(string name)
+        {
+            string[] split = name.Split('/');
+            for (int i = 0; i < split.Length - 1; i++)
+                split[i] = split[i].Replace('-', '_');
+            return $@"{prefix}.{string.Join('.', split)}";
+        }
+
+        public Stream? GetStream(string name)
+        {
+            string file = Path.Combine(directory, manifestName(name));
+            if (File.Exists(file))
+                return File.OpenRead(file);
+
+            return fallback.GetStream(name);
+        }
+
+        public byte[]? Get(string name)
+        {
+            string file = Path.Combine(directory, manifestName(name));
+            return File.Exists(file) ? File.ReadAllBytes(file) : fallback.Get(name);
+        }
+
+        public async Task<byte[]?> GetAsync(string name, CancellationToken cancellationToken = default)
+        {
+            string file = Path.Combine(directory, manifestName(name));
+            if (File.Exists(file))
+                return await File.ReadAllBytesAsync(file, cancellationToken).ConfigureAwait(false);
+
+            return await fallback.GetAsync(name, cancellationToken).ConfigureAwait(false);
+        }
+
+        public IEnumerable<string> GetAvailableResources()
+        {
+            IEnumerable<string> files = Directory.Exists(directory)
+                ? Directory.EnumerateFiles(directory).Select(Path.GetFileName).OfType<string>()
+                           .Where(n => n.StartsWith(prefix + ".", StringComparison.Ordinal))
+                           .Select(toLookupName)
+                : Enumerable.Empty<string>();
+
+            return files.Concat(fallback.GetAvailableResources()).Distinct();
+        }
+
+        // Same transformation as DllResourceStore.GetAvailableResources.
+        private string toLookupName(string n)
+        {
+            n = n.Substring(prefix.Length + 1);
+            int lastDot = n.LastIndexOf('.');
+            char[] chars = n.ToCharArray();
+            for (int i = 0; i < lastDot; i++)
+            {
+                if (chars[i] == '.')
+                    chars[i] = '/';
+            }
+
+            return new string(chars);
+        }
+
+        public void Dispose() => fallback.Dispose();
+    }
+}
+#endif
