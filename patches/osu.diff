+
+using System;
+using System.Buffers;
+using System.Collections.Generic;
+using System.Diagnostics.CodeAnalysis;
+using System.IO;
+using System.Runtime.ExceptionServices;
+using System.Text;
+using MessagePack;
+using MessagePack.Formatters;
+using Microsoft.AspNetCore.Connections;
+using Microsoft.AspNetCore.SignalR;
+using Microsoft.AspNetCore.SignalR.Protocol;
+using osu.Game.Online.Metadata;
+using osu.Game.Users;
+
+namespace osu.Game.Online
+{
+    /// <summary>
+    /// SignalR's "messagepack" hub protocol without runtime code generation, for NativeAOT.
+    /// </summary>
+    /// <remarks>
+    /// The stock <c>MessagePackHubProtocol</c> hands every argument to <c>MessagePackSerializer.Serialize(Type, ref writer, ...)</c>.
+    /// That non-generic entry point is built from expression trees and throws "MessagePackWriter/Reader overload is not
+    /// supported in MessagePackSerializer.NonGenerics" under NativeAOT: the hubs connected, but no call ever went out.
+    /// Here every type that crosses the wire is listed in <see cref="OunsuHubTypes"/> and goes through the generic API, with
+    /// the formatters MessagePack's source generator already puts into osu.Game. The bytes are the same as the stock
+    /// protocol's (console/osu-game: OUNSU_HUB_SELFTEST).
+    /// Only the metadata hub's types are listed (online users, presence, beatmap updates, daily challenge).
+    /// </remarks>
+    public sealed class OunsuMessagePackHubProtocol : IHubProtocol
+    {
+        private const int error_result = 1;
+        private const int void_result = 2;
+        private const int non_void_result = 3;
+
+        private readonly MessagePackSerializerOptions options;
+
+        public OunsuMessagePackHubProtocol()
+            : this(OunsuHubTypes.OPTIONS)
+        {
+        }
+
+        public OunsuMessagePackHubProtocol(MessagePackSerializerOptions options)
+        {
+            this.options = options;
+        }
+
+        public string Name => "messagepack";
+
+        public int Version => 2;
+
+        public TransferFormat TransferFormat => TransferFormat.Binary;
+
+        public bool IsVersionSupported(int version) => version <= Version;
+
+        #region Reading
+
+        public bool TryParseMessage(ref ReadOnlySequence<byte> input, IInvocationBinder binder, [NotNullWhen(true)] out HubMessage? message)
+        {
+            if (!tryParseFrame(ref input, out var payload))
+            {
+                message = null;
+                return false;
+            }
+
+            var reader = new MessagePackReader(payload);
+            message = parseMessage(ref reader, binder);
+            return message != null;
+        }
+
+        private static bool tryParseFrame(ref ReadOnlySequence<byte> buffer, out ReadOnlySequence<byte> payload)
+        {
+            const int max_length_prefix_size = 5;
+
+            payload = default;
+
+            if (buffer.IsEmpty)
+                return false;
+
+            // The payload starts with its length as a VarInt (7 bits per byte, least significant first, top bit = "more").
+            uint length = 0;
+            int numBytes = 0;
+
+            var prefixBuffer = buffer.Slice(0, Math.Min(max_length_prefix_size, buffer.Length));
+            ReadOnlySpan<byte> span = prefixBuffer.IsSingleSegment ? prefixBuffer.First.Span : prefixBuffer.ToArray();
+
+            byte byteRead;
+
+            do
+            {
+                byteRead = span[numBytes];
+                length |= (uint)(byteRead & 0x7f) << (numBytes * 7);
+                numBytes++;
+            } while (numBytes < prefixBuffer.Length && (byteRead & 0x80) != 0);
+
+            // size bytes are missing
+            if ((byteRead & 0x80) != 0 && numBytes < max_length_prefix_size)
+                return false;
+
+            if ((byteRead & 0x80) != 0 || (numBytes == max_length_prefix_size && byteRead > 7))
+                throw new FormatException("Messages over 2GB in size are not supported.");
+
+            // not enough data yet
+            if (buffer.Length < length + numBytes)
+                return false;
+
+            payload = buffer.Slice(numBytes, (int)length);
+            buffer = buffer.Slice(numBytes + (int)length);
+            return true;
+        }
+
+        private HubMessage? parseMessage(ref MessagePackReader reader, IInvocationBinder binder)
+        {
+            int itemCount = reader.ReadArrayHeader();
+            int messageType = readInt32(ref reader, "messageType");
+
+            switch (messageType)
+            {
+                case HubProtocolConstants.InvocationMessageType:
+                    return createInvocationMessage(ref reader, binder, itemCount);
+
+                case HubProtocolConstants.StreamInvocationMessageType:
+                    return createStreamInvocationMessage(ref reader, binder, itemCount);
+
+                case HubProtocolConstants.StreamItemMessageType:
+                    return createStreamItemMessage(ref reader, binder);
+
+                case HubProtocolConstants.CompletionMessageType:
+                    return createCompletionMessage(ref reader, binder);
+
+                case HubProtocolConstants.CancelInvocationMessageType:
+                {
+                    var headers = readHeaders(ref reader);
+                    string? invocationId = readString(ref reader, "invocationId");
+                    throwIfNullOrEmpty(invocationId, "invocation ID for CancelInvocation message");
+                    return applyHeaders(headers, new CancelInvocationMessage(invocationId));
+                }
+
+                case HubProtocolConstants.PingMessageType:
+                    return PingMessage.Instance;
+
+                case HubProtocolConstants.CloseMessageType:
+                    return createCloseMessage(ref reader, itemCount);
+
+                case HubProtocolConstants.AckMessageType:
+                    return new AckMessage(readInt64(ref reader, "sequenceId"));
+
+                case HubProtocolConstants.SequenceMessageType:
+                    return new SequenceMessage(readInt64(ref reader, "sequenceId"));
+
+                default:
+                    // Future protocol changes can add message types, old clients can ignore them
+                    return null;
+            }
+        }
+
+        private HubMessage createInvocationMessage(ref MessagePackReader reader, IInvocationBinder binder, int itemCount)
+        {
+            var headers = readHeaders(ref reader);
+            string? invocationId = readString(ref reader, "invocationId");
+
+            // An empty invocation ID means a non-blocking invocation.
+            if (string.IsNullOrEmpty(invocationId))
+                invocationId = null;
+
+            string? target = readTarget(ref reader, binder);
+            throwIfNullOrEmpty(target, "target for Invocation message");
+
+            object?[] arguments;
+
+            try
+            {
+                arguments = bindArguments(ref reader, binder.GetParameterTypes(target));
+            }
+            catch (Exception ex)
+            {
+                OunsuHubTypes.ReportFailure($"binding arguments of {target}", ex);
+                return new InvocationBindingFailureMessage(invocationId, target, ExceptionDispatchInfo.Capture(ex));
+            }
+
+            string[]? streams = null;
+            if (itemCount > 5)
+                streams = readStreamIds(ref reader);
+
+            return applyHeaders(headers, new InvocationMessage(invocationId, target, arguments, streams));
+        }
+
+        private HubMessage createStreamInvocationMessage(ref MessagePackReader reader, IInvocationBinder binder, int itemCount)
+        {
+            var headers = readHeaders(ref reader);
+            string? invocationId = readString(ref reader, "invocationId");
+            throwIfNullOrEmpty(invocationId, "invocation ID for StreamInvocation message");
+
+            string? target = readString(ref reader, "target");
+            throwIfNullOrEmpty(target, "target for StreamInvocation message");
+
+            object?[] arguments;
+
+            try
+            {
+                arguments = bindArguments(ref reader, binder.GetParameterTypes(target));
+            }
+            catch (Exception ex)
+            {
+                OunsuHubTypes.ReportFailure($"binding arguments of {target}", ex);
+                return new InvocationBindingFailureMessage(invocationId, target, ExceptionDispatchInfo.Capture(ex));
+            }
+
+            string[]? streams = null;
+            if (itemCount > 5)
+                streams = readStreamIds(ref reader);
+
+            return applyHeaders(headers, new StreamInvocationMessage(invocationId, target, arguments, streams));
+        }
+
+        private HubMessage createStreamItemMessage(ref MessagePackReader reader, IInvocationBinder binder)
+        {
+            var headers = readHeaders(ref reader);
+            string? invocationId = readString(ref reader, "invocationId");
+            throwIfNullOrEmpty(invocationId, "invocation ID for StreamItem message");
+
+            object? value;
+
+            try
+            {
+                value = deserializeObject(ref reader, binder.GetStreamItemType(invocationId), "item");
+            }
+            catch (Exception ex)
+            {
+                OunsuHubTypes.ReportFailure("binding a stream item", ex);
+                return new StreamBindingFailureMessage(invocationId, ExceptionDispatchInfo.Capture(ex));
+            }
+
+            return applyHeaders(headers, new StreamItemMessage(invocationId, value));
+        }
+
+        private CompletionMessage createCompletionMessage(ref MessagePackReader reader, IInvocationBinder binder)
+        {
+            var headers = readHeaders(ref reader);
+            string? invocationId = readString(ref reader, "invocationId");
+            throwIfNullOrEmpty(invocationId, "invocation ID for Completion message");
+
+            int resultKind = readInt32(ref reader, "resultKind");
+
+            string? error = null;
+            object? result = null;
+            bool hasResult = false;
+
+            switch (resultKind)
+            {
+                case error_result:
+                    error = readString(ref reader, "error");
+                    break;
+
+                case non_void_result:
+                    hasResult = true;
+
+                    Type? itemType;
+
+                    try
+                    {
+                        itemType = binder.GetReturnType(invocationId);
+                    }
+                    catch (Exception)
+                    {
+                        // the invocation is gone (cancelled, or the connection was restarted)
+                        itemType = null;
+                    }
+
+                    if (itemType == null)
+                        reader.Skip();
+                    else if (itemType == typeof(RawResult))
+                        result = new RawResult(reader.ReadRaw());
+                    else
+                    {
+                        try
+                        {
+                            result = deserializeObject(ref reader, itemType, "argument");
+                        }
+                        catch (Exception ex)
+                        {
+                            OunsuHubTypes.ReportFailure($"reading a result of type {itemType.Name}", ex);
+                            error = $"Error trying to deserialize result to {itemType.Name}. {ex.Message}";
+                            hasResult = false;
+                        }
+                    }
+
+                    break;
+
+                case void_result:
+                    break;
+
+                default:
+                    throw new InvalidDataException("Invalid invocation result kind.");
+            }
+
+            return applyHeaders(headers, new CompletionMessage(invocationId, error, result, hasResult));
+        }
+
+        private static CloseMessage createCloseMessage(ref MessagePackReader reader, int itemCount)
+        {
+            string? error = readString(ref reader, "error");
+            bool allowReconnect = false;
+
+            if (itemCount > 2)
+            {
+                try
+                {
+                    allowReconnect = reader.ReadBoolean();
+                }
+                catch (Exception ex)
+                {
+                    throw new InvalidDataException("Reading 'allowReconnect' as Boolean failed.", ex);
+                }
+            }
+
+            // An empty string is still an error
+            if (error == null && !allowReconnect)
+                return CloseMessage.Empty;
+
+            return new CloseMessage(error, allowReconnect);
+        }
+
+        private static Dictionary<string, string>? readHeaders(ref MessagePackReader reader)
+        {
+            long headerCount;
+
+            try
+            {
+                headerCount = reader.ReadMapHeader();
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException("Reading map length for 'headers' failed.", ex);
+            }
+
+            if (headerCount <= 0)
+                return null;
+
+            var headers = new Dictionary<string, string>(StringComparer.Ordinal);
+
+            for (int i = 0; i < headerCount; i++)
+            {
+                string? key = readString(ref reader, "headers.Key");
+                throwIfNullOrEmpty(key, "key in header");
+
+                string? value = readString(ref reader, "headers.Value");
+                throwIfNullOrEmpty(value, "value in header");
+
+                headers.Add(key, value);
+            }
+
+            return headers;
+        }
+
+        private static string[]? readStreamIds(ref MessagePackReader reader)
+        {
+            long count = readArrayLength(ref reader, "streamIds");
+
+            if (count <= 0)
+                return null;
+
+            var streams = new List<string>();
+
+            for (int i = 0; i < count; i++)
+            {
+                string? id = reader.ReadString();
+                throwIfNullOrEmpty(id, "value in streamIds received");
+                streams.Add(id);
+            }
+
+            return streams.ToArray();
+        }
+
+        private object?[] bindArguments(ref MessagePackReader reader, IReadOnlyList<Type> parameterTypes)
+        {
+            long argumentCount = readArrayLength(ref reader, "arguments");
+
+            if (parameterTypes.Count != argumentCount)
+                throw new InvalidDataException($"Invocation provides {argumentCount} argument(s) but target expects {parameterTypes.Count}.");
+
+            try
+            {
+                object?[] arguments = new object?[argumentCount];
+                for (int i = 0; i < argumentCount; i++)
+                    arguments[i] = deserializeObject(ref reader, parameterTypes[i], "argument");
+
+                return arguments;
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException("Error binding arguments. Make sure that the types of the provided values match the types of the hub method being invoked.", ex);
+            }
+        }
+
+        private object? deserializeObject(ref MessagePackReader reader, Type type, string field)
+        {
+            try
+            {
+                return OunsuHubTypes.Deserialize(ref reader, type, options);
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException($"Deserializing object of the `{type.Name}` type for '{field}' failed.", ex);
+            }
+        }
+
+        private static T applyHeaders<T>(Dictionary<string, string>? source, T destination)
+            where T : HubInvocationMessage
+        {
+            if (source != null && source.Count > 0)
+                destination.Headers = source;
+
+            return destination;
+        }
+
+        private static int readInt32(ref MessagePackReader reader, string field)
+        {
+            try
+            {
+                return reader.ReadInt32();
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException($"Reading '{field}' as Int32 failed.", ex);
+            }
+        }
+
+        private static long readInt64(ref MessagePackReader reader, string field)
+        {
+            try
+            {
+                return reader.ReadInt64();
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException($"Reading '{field}' as Int64 failed.", ex);
+            }
+        }
+
+        private static string? readTarget(ref MessagePackReader reader, IInvocationBinder binder)
+        {
+            try
+            {
+                if (reader.TryReadStringSpan(out var span))
+                    return binder.GetTarget(span) ?? Encoding.UTF8.GetString(span);
+
+                return reader.ReadString();
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException("Reading 'target' as String failed.", ex);
+            }
+        }
+
+        private static string? readString(ref MessagePackReader reader, string field)
+        {
+            try
+            {
+                return reader.ReadString();
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException($"Reading '{field}' as String failed.", ex);
+            }
+        }
+
+        private static long readArrayLength(ref MessagePackReader reader, string field)
+        {
+            try
+            {
+                return reader.ReadArrayHeader();
+            }
+            catch (Exception ex)
+            {
+                throw new InvalidDataException($"Reading array length for '{field}' failed.", ex);
+            }
+        }
+
+        private static void throwIfNullOrEmpty([NotNull] string? target, string message)
+        {
+            if (string.IsNullOrEmpty(target))
+                throw new InvalidDataException($"Null or empty {message}.");
+        }
+
+        #endregion
+
+        #region Writing
+
+        [ThreadStatic]
+        private static ArrayBufferWriter<byte>? cachedBuffer;
+
+        public void WriteMessage(HubMessage message, IBufferWriter<byte> output)
+        {
+            var buffer = writeToBuffer(message);
+
+            try
+            {
+                // length, then the message
+                Span<byte> prefix = stackalloc byte[5];
+                int prefixLength = writeLengthPrefix(buffer.WrittenCount, prefix);
+                output.Write(prefix.Slice(0, prefixLength));
+                output.Write(buffer.WrittenSpan);
+            }
+            finally
+            {
+                returnBuffer(buffer);
+            }
+        }
+
+        public ReadOnlyMemory<byte> GetMessageBytes(HubMessage message)
+        {
+            var buffer = writeToBuffer(message);
+
+            try
+            {
+                Span<byte> prefix = stackalloc byte[5];
+                int prefixLength = writeLengthPrefix(buffer.WrittenCount, prefix);
+
+                byte[] array = new byte[prefixLength + buffer.WrittenCount];
+                prefix.Slice(0, prefixLength).CopyTo(array);
+                buffer.WrittenSpan.CopyTo(array.AsSpan(prefixLength));
+                return array;
+            }
+            finally
+            {
+                returnBuffer(buffer);
+            }
+        }
+
+        private ArrayBufferWriter<byte> writeToBuffer(HubMessage message)
+        {
+            var buffer = cachedBuffer ?? new ArrayBufferWriter<byte>(256);
+            cachedBuffer = null;
+
+            try
+            {
+                var writer = new MessagePackWriter(buffer);
+                writeMessageCore(message, ref writer);
+                writer.Flush();
+                return buffer;
+            }
+            catch (Exception ex)
+            {
+                returnBuffer(buffer);
+                OunsuHubTypes.ReportFailure($"writing a {message.GetType().Name}{(message is HubMethodInvocationMessage m ? $" ({m.Target})" : string.Empty)}", ex);
+                throw;
+            }
+        }
+
+        private static void returnBuffer(ArrayBufferWriter<byte> buffer)
+        {
+            // keep small buffers only
+            if (buffer.Capacity > 64 * 1024)
+                return;
+
+            buffer.ResetWrittenCount();
+            cachedBuffer = buffer;
+        }
+
+        private static int writeLengthPrefix(long length, Span<byte> output)
+        {
+            int numBytes = 0;
+
+            do
+            {
+                ref byte current = ref output[numBytes];
+                current = (byte)(length & 0x7f);
+                length >>= 7;
+                if (length > 0)
+                    current |= 0x80;
+                numBytes++;
+            } while (length > 0);
+
+            return numBytes;
+        }
+
+        private void writeMessageCore(HubMessage message, ref MessagePackWriter writer)
+        {
+            switch (message)
+            {
+                case InvocationMessage invocation:
+                    writer.WriteArrayHeader(6);
+                    writer.Write(HubProtocolConstants.InvocationMessageType);
+                    packHeaders(invocation.Headers, ref writer);
+                    if (string.IsNullOrEmpty(invocation.InvocationId))
+                        writer.WriteNil();
+                    else
+                        writer.Write(invocation.InvocationId);
+                    writer.Write(invocation.Target);
+                    writeArguments(invocation.Arguments, ref writer);
+                    writeStreamIds(invocation.StreamIds, ref writer);
+                    break;
+
+                case StreamInvocationMessage streamInvocation:
+                    writer.WriteArrayHeader(6);
+                    writer.Write(HubProtocolConstants.StreamInvocationMessageType);
+                    packHeaders(streamInvocation.Headers, ref writer);
+                    writer.Write(streamInvocation.InvocationId);
+                    writer.Write(streamInvocation.Target);
+                    writeArguments(streamInvocation.Arguments, ref writer);
+                    writeStreamIds(streamInvocation.StreamIds, ref writer);
+                    break;
+
+                case StreamItemMessage streamItem:
+                    writer.WriteArrayHeader(4);
+                    writer.Write(HubProtocolConstants.StreamItemMessageType);
+                    packHeaders(streamItem.Headers, ref writer);
+                    writer.Write(streamItem.InvocationId);
+                    writeArgument(streamItem.Item, ref writer);
+                    break;
+
+                case CompletionMessage completion:
+                {
+                    int resultKind = completion.Error != null ? error_result : completion.HasResult ? non_void_result : void_result;
+
+                    writer.WriteArrayHeader(4 + (resultKind != void_result ? 1 : 0));
+                    writer.Write(HubProtocolConstants.CompletionMessageType);
+                    packHeaders(completion.Headers, ref writer);
+                    writer.Write(completion.InvocationId);
+                    writer.Write(resultKind);
+
+                    if (resultKind == error_result)
+                        writer.Write(completion.Error);
+                    else if (resultKind == non_void_result)
+                        writeArgument(completion.Result, ref writer);
+                    break;
+                }
+
+                case CancelInvocationMessage cancel:
+                    writer.WriteArrayHeader(3);
+                    writer.Write(HubProtocolConstants.CancelInvocationMessageType);
+                    packHeaders(cancel.Headers, ref writer);
+                    writer.Write(cancel.InvocationId);
+                    break;
+
+                case PingMessage:
+                    writer.WriteArrayHeader(1);
+                    writer.Write(HubProtocolConstants.PingMessageType);
+                    break;
+
+                case CloseMessage close:
+                    writer.WriteArrayHeader(3);
+                    writer.Write(HubProtocolConstants.CloseMessageType);
+                    if (string.IsNullOrEmpty(close.Error))
+                        writer.WriteNil();
+                    else
+                        writer.Write(close.Error);
+                    writer.Write(close.AllowReconnect);
+                    break;
+
+                case AckMessage ack:
+                    writer.WriteArrayHeader(2);
+                    writer.Write(HubProtocolConstants.AckMessageType);
+                    writer.Write(ack.SequenceId);
+                    break;
+
+                case SequenceMessage sequence:
+                    writer.WriteArrayHeader(2);
+                    writer.Write(HubProtocolConstants.SequenceMessageType);
+                    writer.Write(sequence.SequenceId);
+                    break;
+
+                default:
+                    throw new InvalidDataException($"Unexpected message type: {message.GetType().Name}");
+            }
+        }
+
+        private void writeArguments(object?[]? arguments, ref MessagePackWriter writer)
+        {
+            if (arguments == null)
+            {
+                writer.WriteArrayHeader(0);
+                return;
+            }
+
+            writer.WriteArrayHeader(arguments.Length);
+            foreach (object? argument in arguments)
+                writeArgument(argument, ref writer);
+        }
+
+        private void writeArgument(object? argument, ref MessagePackWriter writer)
+        {
+            if (argument == null)
+                writer.WriteNil();
+            else if (argument is RawResult result)
+                writer.WriteRaw(result.RawSerializedData);
+            else
+                OunsuHubTypes.Serialize(ref writer, argument, options);
+        }
+
+        private static void writeStreamIds(string[]? streamIds, ref MessagePackWriter writer)
+        {
+            if (streamIds == null)
+            {
+                writer.WriteArrayHeader(0);
+                return;
+            }
+
+            writer.WriteArrayHeader(streamIds.Length);
+            foreach (string streamId in streamIds)
+                writer.Write(streamId);
+        }
+
+        private static void packHeaders(IDictionary<string, string>? headers, ref MessagePackWriter writer)
+        {
+            if (headers == null)
+            {
+                writer.WriteMapHeader(0);
+                return;
+            }
+
+            writer.WriteMapHeader(headers.Count);
+
+            foreach (var header in headers)
+            {
+                writer.Write(header.Key);
+                writer.Write(header.Value);
+            }
+        }
+
+        #endregion
+    }
+
+    /// <summary>
+    /// The types <see cref="OunsuMessagePackHubProtocol"/> can put on the wire, each with code compiled ahead of time.
+    /// To support another hub method, add its argument and return types to <see cref="types"/> (and, for nullable structs,
+    /// arrays or enums that are members of other types, a formatter to <see cref="Resolver.formatters"/>), then add a case to
+    /// the self-test in console/osu-game.
+    /// </summary>
+    public static class OunsuHubTypes
+    {
+        /// <summary>
+        /// Serialisation failures so far (a type missing from the list, or data in an unexpected shape). Zero when all is well.
+        /// </summary>
+        public static int Failures;
+
+        /// <summary>
+        /// Invoked with a one-line description of each of the first few failures.
+        /// </summary>
+        public static Action<string>? FailureReported;
+
+        internal static void ReportFailure(string what, Exception ex)
+        {
+            // the first three as notifications (Important), up to 20 in the log, then silence
