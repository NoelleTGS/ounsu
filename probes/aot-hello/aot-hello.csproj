<Project Sdk="Microsoft.NET.Sdk">
  <!-- NativeAOT probe for the lx host on kaiHEN. Build with ./build.sh: ILC emits an object, tools/aot-island.py
       links it into an island, lx/host makes the .nro. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-musl-arm64</RuntimeIdentifier>
    <StaticExecutable>true</StaticExecutable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>false</StripSymbols>
    <!-- No signals (no background-GC activation); keep the GC simple. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cap what the GC reserves (heap memory backs every mapping). -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="134217728" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionRange" Value="268435456" />
    <!-- Resolve libc P/Invokes at link time (no dlopen on the console). -->
    <DirectPInvoke Include="libc" />
  </ItemGroup>
</Project>
