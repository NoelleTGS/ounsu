<Project Sdk="Microsoft.NET.Sdk">
  <!-- Networking probe for hbxl (sockets, epoll, DNS, TLS, HttpClient, WebSocket).  Build with ./build.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-musl-arm64</RuntimeIdentifier>
    <StaticExecutable>true</StaticExecutable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <StripSymbols>false</StripSymbols>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="134217728" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionRange" Value="268435456" />
    <!-- hbxl sockets are IPv4 only: never try AF_INET6 / dual-mode sockets. -->
    <RuntimeHostConfigurationOption Include="System.Net.DisableIPv6" Value="true" />
    <DirectPInvoke Include="libc" />
    <DirectPInvoke Include="hbxl" />
  </ItemGroup>
</Project>
