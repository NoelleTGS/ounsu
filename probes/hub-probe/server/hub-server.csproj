<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>hub-server</AssemblyName>
    <RootNamespace>HubProbe</RootNamespace>
    <!-- No ASP.NET shared runtime is installed on the build PC: carry it along. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Arch's SDK package has no prune data for the ASP.NET framework (NETSDK1226). -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>
  <ItemGroup>
    <!-- For the message types and SignalRUnionWorkaroundResolver, exactly as osu-server-spectator uses them. -->
    <ProjectReference Include="../../../src/osu/osu.Game/osu.Game.csproj" />
  </ItemGroup>
</Project>
