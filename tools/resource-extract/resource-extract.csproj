<Project Sdk="Microsoft.NET.Sdk">
  <!-- PC-side tool for the Switch 2 port: list/extract embedded resources of .NET assemblies
       and write an ILLink substitutions file that removes them from the NativeAOT image. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
